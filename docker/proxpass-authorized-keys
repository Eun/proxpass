#!/bin/sh
# sshd AuthorizedKeysCommand wrapper.
#
# sshd refuses to run an AuthorizedKeysCommand unless it is an absolute path
# owned by root and not writable by group or others, hence this fixed wrapper
# instead of pointing sshd straight at /app with arguments.
#
# Prints the authorized_keys lines for $1 on stdout and nothing else: any
# proxpass diagnostics must go to stderr, because sshd parses stdout.
set -eu

# sshd scrubs the environment for this helper, so PROXPASS_DATA is not set
# here. The entrypoint left the DSN where it can be read; without it the
# binary would fall back to its SQLite default and silently use the wrong
# database. See the note in docker/entrypoint.sh.
DSN_FILE="/run/proxpass/dsn"
if [ -r "${DSN_FILE}" ]; then
	PROXPASS_DATA="$(cat "${DSN_FILE}")"
	export PROXPASS_DATA
fi

exec /app authorized-keys "$@"
