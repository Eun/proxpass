#!/bin/sh
# sshd ForceCommand wrapper.
#
# Replaces whatever the client asked for. `proxpass session' picks the real
# request up from $SSH_ORIGINAL_COMMAND (which sshd sets for us): empty means
# "show the interactive guest list", anything else names a target.
set -eu

# sshd scrubs the environment for this helper, so PROXPASS_DATA is not set
# here. The entrypoint left the DSN where it can be read; without it the
# binary would fall back to its SQLite default and silently use the wrong
# database. See the note in docker/entrypoint.sh.
DSN_FILE="/run/proxpass/dsn"
if [ -r "${DSN_FILE}" ]; then
	PROXPASS_DATA="$(cat "${DSN_FILE}")"
	export PROXPASS_DATA
fi

# The log level, for the same reason and by the same route. Without it a
# session always runs at the default, so `--log-level=debug' on the server
# would not reach the sessions an operator is trying to debug.
LEVEL_FILE="/run/proxpass/log-level"
if [ -r "${LEVEL_FILE}" ]; then
	PROXPASS_LOG_LEVEL="$(cat "${LEVEL_FILE}")"
	export PROXPASS_LOG_LEVEL
fi

exec /app session
